{
  "id": "default",
  "name": "Default Theme (Ant Design 5.x Enterprise)",
  "base_tokens": "ui-system/tokens.css",
  "visual_language": {
    "color": {
      "primary": "#1677ff",
      "success": "#52c41a",
      "warning": "#faad14",
      "error": "#ff4d4f",
      "info": "#1677ff",
      "text_primary": "rgba(0,0,0,0.88)",
      "text_secondary": "rgba(0,0,0,0.65)",
      "bg_layout": "#f5f5f5",
      "bg_container": "#ffffff"
    },
    "typography": {
      "font_family": "-apple-system, 'Segoe UI', Roboto, 'Microsoft YaHei', sans-serif",
      "font_size_scale": ["12px", "13px", "14px", "16px", "20px", "24px"],
      "line_height": 1.5714,
      "font_weights": [400, 500, 600]
    },
    "spacing": {
      "base": "4px",
      "scale": ["2px", "4px", "8px", "12px", "16px", "24px", "32px", "48px"]
    },
    "radius": {
      "sm": "4px",
      "default": "6px",
      "lg": "8px",
      "xl": "12px"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(0,0,0,0.03)",
      "md": "0 6px 16px rgba(0,0,0,0.08)",
      "lg": "0 12px 48px rgba(0,0,0,0.12)"
    },
    "component_visual_style": {
      "button_primary": "filled, no border",
      "table_header": "bg-fill, semibold",
      "card_border": "1px solid border-secondary, radius-lg",
      "tag": "soft-filled background",
      "status_dot": "6px round, semantic color"
    }
  },
  "not_responsible_for": [
    "page structure",
    "region ratios",
    "Page Template",
    "Layout Pattern selection",
    "content business logic"
  ],
  "future_themes_note": "Theme 02/03: create themes/<id>/theme.json with same schema, override visual_language only. Template/Layout/Component unchanged."
}
