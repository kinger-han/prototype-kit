<div class="confirm-overlay" id="deleteVenueConfirm">
  <div class="delete-confirm-box">
    <div class="delete-confirm-icon">⚠️</div>
    <div class="delete-confirm-title">确认删除场馆？</div>
    <div class="delete-confirm-desc" id="deleteVenueDesc">删除后该场馆的二维码将立即失效，历史会话数据将保留。此操作不可恢复。</div>
    <div class="confirm-actions">
      <button class="confirm-btn" onclick="closeDeleteVenueConfirm()">取消</button>
      <button class="confirm-btn danger" onclick="doDeleteVenue()">确认删除</button>
    </div>
  </div>
</div>


<!-- ====== 新增/编辑问答弹窗 ====== -->
<div class="modal-overlay" id="faqFormModal">
  <div class="modal" style="width:600px;max-height:80vh;">
    <div class="modal-header">
      <h3 id="faqFormTitle">新增问答</h3>
      <button class="modal-close" onclick="closeFaqFormModal()">&#10005;</button>
    </div>
    <div class="modal-body">
      <div class="faq-form">
        <div class="form-row">
          <span class="form-label">所属客户：<span class="required">*</span></span>
          <select class="form-control" id="faqFormCustomer"><option value="">请选择客户</option><option>XX博物馆</option><option>科技馆</option><option>自然博物馆</option></select>
        </div>
        <div class="form-row">
          <span class="form-label">所属场馆：<span class="required">*</span></span>
          <select class="form-control" id="faqFormVenue"><option value="">请选择场馆</option><option>东馆</option><option>西馆</option><option>少儿馆</option><option>主馆</option></select>
        </div>
        <div class="form-row">
          <span class="form-label">标准问题：<span class="required">*</span></span>
          <input type="text" class="form-control" id="faqFormQuestion" placeholder="请输入标准问题">
        </div>
        <div class="form-row">
          <span class="form-label">相似问法：</span>
          <div style="flex:1;">
            <textarea class="form-control" id="faqFormSimilar" placeholder="每行一条相似问法，可留空"></textarea>
            <div class="form-hint">每行一条，用户以任意一种问法提问都会匹配此答案</div>
          </div>
        </div>
        <div class="form-row">
          <span class="form-label">答案内容：<span class="required">*</span></span>
          <textarea class="form-control" id="faqFormAnswer" placeholder="请输入答案内容"></textarea>
        </div>
        <div class="form-row">
          <span class="form-label">分类标签：</span>
          <select class="form-control" id="faqFormTag" style="width:200px;"><option value="">请选择标签</option><option>门票</option><option>路线</option><option>设施</option><option>停车</option><option>讲解服务</option><option>综合导览</option><option>其他</option></select>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid #f0f0f0;">
        <button class="confirm-btn" onclick="closeFaqFormModal()">取消</button>
        <button class="confirm-btn export-btn-confirm" onclick="submitFaqForm()">提交</button>
      </div>
    </div>
  </div>
</div>

<!-- ====== 上传文档弹窗 ====== -->
<div class="modal-overlay" id="docUploadModal">
  <div class="modal" style="width:520px;">
    <div class="modal-header">
      <h3>上传文档</h3>
      <button class="modal-close" onclick="closeDocUploadModal()">&#10005;</button>
    </div>
    <div class="modal-body">
      <div class="faq-form">
        <div class="form-row">
          <span class="form-label">所属客户：<span class="required">*</span></span>
          <select class="form-control" id="docUploadCustomer"><option value="">请选择客户</option><option>XX博物馆</option><option>科技馆</option><option>自然博物馆</option></select>
        </div>
        <div class="form-row">
          <span class="form-label">所属场馆：<span class="required">*</span></span>
          <select class="form-control" id="docUploadVenue"><option value="">请选择场馆</option><option>东馆</option><option>西馆</option><option>少儿馆</option><option>主馆</option></select>
        </div>
        <div class="form-row">
          <span class="form-label">上传文件：</span>
          <div style="flex:1;"><div style="border:2px dashed #d9d9d9;border-radius:8px;padding:30px;text-align:center;cursor:pointer;" onclick="showToast(&apos;文件选择器（演示）&apos;)"><div style="color:#999;font-size:13px;">点击或拖拽文件到此处上传</div><div style="color:#bbb;font-size:11px;margin-top:4px;">支持 PDF/DOCX/TXT/MD，单文件不超过20MB，最多10个</div></div></div>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid #f0f0f0;">
        <button class="confirm-btn" onclick="closeDocUploadModal()">取消</button>
        <button class="confirm-btn export-btn-confirm" onclick="submitDocUpload()">提交</button>
      </div>
    </div>
  </div>
</div>

<!-- ====== 查看关联未命中问题弹窗 ====== -->
