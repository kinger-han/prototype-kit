let disablePhone = '';
function toggleMenu(el) {
  el.classList.toggle('expanded');
  const sub = el.nextElementSibling;
  if (sub && sub.classList.contains('sub-menu')) sub.classList.toggle('open');
}
function switchPage(pageTitle, element) {
  document.querySelectorAll('.sub-menu .menu-item').forEach(m => m.classList.remove('active'));
  if (element) element.classList.add('active');
  updateBreadcrumb(pageTitle);
}
function showToast(text, type) {
  const toast = document.getElementById('toast');
  const icons = { success: '✓', error: '✕', warn: '⚠' };
  toast.className = 'toast ' + (type || '');
  toast.innerHTML = '<span class="toast-icon">' + (icons[type] || '✓') + '</span>' + text;
  toast.classList.add('show');
  setTimeout(function() { toast.classList.remove('show'); }, 2500);
}
function updateBreadcrumb(title) {
  document.querySelector('.breadcrumb .current').textContent = title;
}
</script>
</body>
</html>