<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>智融平台 - 场馆管理</title>
<style>

* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", sans-serif;
  background: #f0f2f5; color: #333; font-size: 14px;
  overflow: hidden; height: 100vh;
}
.layout { display: flex; height: 100vh; }

/* ====== 左侧导航栏（白色底+蓝色选中字） ====== */
.sidebar {
  width: 200px; background: #FDFEFF; flex-shrink: 0;
  display: flex; flex-direction: column; overflow-y: auto;
  border-right: 1px solid #e8e8e8;
}
.sidebar-logo {
  height: 56px; display: flex; align-items: center;
  padding: 0 20px; border-bottom: 1px solid #f0f0f0;
}
.sidebar-logo span { color: #1a1a1a; font-size: 16px; font-weight: 700; letter-spacing: 2px; }
.sidebar-menu { flex: 1; padding: 8px 0; }
.menu-item {
  display: flex; align-items: center; padding: 0 20px; height: 40px;
  color: #333; cursor: pointer; transition: all 0.15s; font-size: 14px;
}
.menu-item:hover { color: #0B5DEA; }
.menu-item.active { color: #0B5DEA; font-weight: 500; }
.menu-item .menu-icon { width: 16px; margin-right: 10px; text-align: center; font-size: 14px; }
.menu-item .menu-arrow { margin-left: auto; font-size: 12px; color: #bbb; }
.menu-group-title {
  display: flex; align-items: center; padding: 0 20px; height: 40px;
  color: #333; cursor: pointer; font-size: 14px;
}
.menu-group-title:hover { color: #0B5DEA; }
.menu-group-title .menu-icon { width: 16px; margin-right: 10px; text-align: center; font-size: 14px; }
.menu-group-title .menu-arrow { margin-left: auto; font-size: 12px; color: #bbb; transition: transform 0.2s; }
.menu-group-title.expanded .menu-arrow { transform: rotate(180deg); }
.sub-menu { display: none; }
.sub-menu.open { display: block; }
.sub-menu .menu-item { padding-left: 46px; font-size: 13px; }

/* ====== 右侧主区域 ====== */
.main-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.top-nav {
  height: 56px; background: #fff; border-bottom: 1px solid #e8e8e8;
  display: flex; align-items: center; padding: 0 24px; flex-shrink: 0;
}
.breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 14px; color: #666; }
.breadcrumb a { color: #666; text-decoration: none; }
.breadcrumb a:hover { color: #0B5DEA; }
.breadcrumb .sep { color: #ccc; }
.breadcrumb .current { color: #333; font-weight: 500; }
.top-nav-right { margin-left: auto; display: flex; align-items: center; gap: 18px; }
.nav-greeting { font-size: 13px; color: #666; }
.nav-icon { width: 20px; height: 20px; color: #999; cursor: pointer; position: relative; }
.nav-icon:hover { color: #333; }
.nav-badge {
  position: absolute; top: -6px; right: -8px; background: #f5222d; color: #fff;
  font-size: 10px; min-width: 16px; height: 16px; line-height: 16px;
  text-align: center; border-radius: 8px; padding: 0 4px;
}
.nav-avatar {
  width: 32px; height: 32px; background: #e8e8e8; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; cursor: pointer;
}
.nav-avatar svg { width: 18px; height: 18px; color: #999; }

/* 内容区域（无水印） */
.content-area { flex: 1; padding: 16px; overflow-y: auto; background: #f0f2f5; }

/* ====== 页面标题栏 ====== */
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.page-title { font-size: 16px; font-weight: 600; color: #333; }
.page-title .sub { font-size: 12px; color: #999; font-weight: 400; margin-left: 8px; }

/* ====== 筛选栏 ====== */
.filter-bar {
  background: #fff; border-radius: 4px; padding: 16px; margin-bottom: 12px;
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
}
.filter-item { display: flex; align-items: center; gap: 6px; }
.filter-label { font-size: 13px; color: #666; white-space: nowrap; }
.filter-select, .filter-input {
  height: 32px; border: 1px solid #d9d9d9; border-radius: 4px;
  padding: 0 10px; font-size: 13px; color: #333; background: #fff; outline: none; min-width: 140px;
}
.filter-select:focus, .filter-input:focus { border-color: #0B5DEA; }
.filter-btn {
  height: 32px; padding: 0 16px; border-radius: 4px; font-size: 13px;
  cursor: pointer; display: flex; align-items: center; gap: 4px;
  border: 1px solid #d9d9d9; background: #fff; color: #333; transition: all 0.15s;
}
.filter-btn:hover { border-color: #0B5DEA; color: #0B5DEA; }
.filter-btn.primary { background: #0B5DEA; color: #fff; border-color: #0B5DEA; }
.filter-btn.primary:hover { background: #3a7bef; }
.filter-btn svg { width: 14px; height: 14px; }

/* ====== 数据表格 ====== */
.table-card { background: #fff; border-radius: 4px; overflow: hidden; }
.table-toolbar {
  padding: 12px 16px; display: flex; align-items: center; gap: 10px;
  border-bottom: 1px solid #f0f0f0;
}
.toolbar-btn {
  height: 30px; padding: 0 12px; border: 1px solid #d9d9d9; border-radius: 4px;
  background: #fff; font-size: 13px; color: #666; cursor: pointer;
  display: flex; align-items: center; gap: 4px;
}
.toolbar-btn:hover { color: #0B5DEA; border-color: #0B5DEA; }
.toolbar-btn svg { width: 14px; height: 14px; }
.toolbar-search { margin-left: auto; display: flex; align-items: center; }
.toolbar-search input {
  height: 30px; border: 1px solid #d9d9d9; border-radius: 4px 0 0 4px;
  padding: 0 10px; font-size: 13px; width: 200px; outline: none;
}
.toolbar-search input:focus { border-color: #0B5DEA; }
.toolbar-search .search-btn {
  height: 30px; width: 36px; background: #0B5DEA; border: 1px solid #0B5DEA;
  border-radius: 0 4px 4px 0; color: #fff; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.toolbar-search .search-btn svg { width: 14px; height: 14px; }

table { width: 100%; border-collapse: collapse; }
table th {
  background: #fafafa; padding: 10px 12px; font-size: 13px; font-weight: 600;
  color: #333; text-align: left; border-bottom: 1px solid #f0f0f0; white-space: nowrap;
}
table td {
  padding: 12px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0;
}
table tr:hover { background: #e6f7ff; }
table tr { cursor: pointer; }

.user-phone { color: #0B5DEA; cursor: pointer; font-weight: 500; }
.user-phone:hover { text-decoration: underline; }
.user-nickname { display: flex; align-items: center; gap: 8px; }
.user-nickname .avatar-mini {
  width: 28px; height: 28px; background: #f0d9b5; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: #8b5e3c;
}
.badge-status {
  display: inline-block; padding: 2px 10px; border-radius: 10px;
  font-size: 12px; line-height: 1.6;
}
.badge-status.active { background: #e6fffb; color: #13c2c2; border: 1px solid #b5f5ec; }
.badge-status.disabled { background: #fff1f0; color: #f5222d; border: 1px solid #ffa39e; }
.venue-tags { display: flex; gap: 4px; flex-wrap: wrap; }
.venue-tag {
  display: inline-block; padding: 1px 8px; background: #f0f5ff;
  border: 1px solid #d6e4ff; border-radius: 3px; font-size: 12px; color: #0B5DEA;
}
.venue-tag.more { background: #f5f5f5; border-color: #e8e8e8; color: #999; }
.num-highlight { font-weight: 600; color: #333; }
.action-btn {
  color: #0B5DEA; cursor: pointer; font-size: 13px;
  border: none; background: none; padding: 2px 6px;
}
.action-btn:hover { text-decoration: underline; }
.action-btn.danger { color: #f5222d; }

/* ====== 分页 ====== */
.pagination {
  padding: 12px 16px; display: flex; align-items: center;
  justify-content: space-between; border-top: 1px solid #f0f0f0;
}
.page-info { font-size: 13px; color: #666; }
.page-size-select { height: 28px; border: 1px solid #d9d9d9; border-radius: 4px; padding: 0 8px; font-size: 13px; margin: 0 6px; }
.page-btns { display: flex; align-items: center; gap: 4px; }
.page-btn {
  min-width: 28px; height: 28px; border: 1px solid #d9d9d9; border-radius: 4px;
  background: #fff; font-size: 13px; color: #333; cursor: pointer;
  display: flex; align-items: center; justify-content: center; padding: 0 6px;
}
.page-btn:hover { color: #0B5DEA; border-color: #0B5DEA; }
.page-btn.active { background: #0B5DEA; color: #fff; border-color: #0B5DEA; }
.page-btn.disabled { color: #ccc; cursor: not-allowed; }
.page-jump { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #666; margin-left: 12px; }
.page-jump input { width: 40px; height: 28px; border: 1px solid #d9d9d9; border-radius: 4px; text-align: center; font-size: 13px; outline: none; }

/* ====== 弹窗通用 ====== */
.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.45); z-index: 1000; display: none;
  justify-content: center; align-items: center;
}
.modal-overlay.show { display: flex; }
.modal {
  background: #fff; border-radius: 6px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.15);
  display: flex; flex-direction: column;
  animation: modalIn 0.2s ease;
}
@keyframes modalIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
.modal-header {
  padding: 16px 24px; border-bottom: 1px solid #f0f0f0;
  display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
}
.modal-header h3 { font-size: 16px; font-weight: 600; color: #333; }
.modal-close {
  width: 28px; height: 28px; border: none; background: none;
  cursor: pointer; color: #999; font-size: 18px;
  display: flex; align-items: center; justify-content: center; border-radius: 4px;
}
.modal-close:hover { background: #f5f5f5; color: #333; }
.modal-body { flex: 1; overflow-y: auto; padding: 20px 24px; }

/* ====== 用户详情弹窗（固定尺寸） ====== */
.user-detail-modal { width: 820px; height: 620px; }
.detail-tabs {
  display: flex; gap: 0; border-bottom: 1px solid #f0f0f0;
  padding: 0 24px; flex-shrink: 0;
}
.detail-tab {
  padding: 12px 20px; font-size: 14px; color: #666; cursor: pointer;
  border-bottom: 2px solid transparent; transition: all 0.15s;
}
.detail-tab:hover { color: #0B5DEA; }
.detail-tab.active { color: #0B5DEA; border-bottom-color: #0B5DEA; font-weight: 500; }
.detail-content { display: none; padding: 20px 24px; overflow-y: auto; flex: 1; }
.detail-content.active { display: block; }

/* 基本信息 */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 32px; }
.info-item { display: flex; flex-direction: column; gap: 4px; }
.info-label { font-size: 12px; color: #999; }
.info-value { font-size: 14px; color: #333; min-height: 22px; }

/* 关联客户 */
.venue-list { display: flex; flex-direction: column; gap: 12px; }
.venue-card {
  border: 1px solid #f0f0f0; border-radius: 6px; padding: 14px 16px;
  display: flex; align-items: center; gap: 16px; transition: all 0.15s;
}
.venue-card:hover { border-color: #0B5DEA; background: #f9fbff; }
.venue-icon {
  width: 40px; height: 40px; background: linear-gradient(160deg, #3d2515, #8b5e3c);
  border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.venue-icon svg { width: 22px; height: 22px; color: #f0d9b5; }
.venue-info { flex: 1; }
.venue-name { font-size: 14px; font-weight: 500; color: #333; margin-bottom: 4px; }
.venue-meta { display: flex; gap: 20px; font-size: 12px; color: #999; }
.venue-meta span { display: flex; align-items: center; gap: 4px; }
.venue-stats { text-align: right; flex-shrink: 0; }
.venue-stats .num { font-size: 20px; font-weight: 600; color: #0B5DEA; }
.venue-stats .label { font-size: 11px; color: #999; }

/* 会话记录 */
.session-timeline { position: relative; padding-left: 24px; }
.session-timeline::before {
  content: ''; position: absolute; left: 8px; top: 0; bottom: 0;
  width: 2px; background: #f0f0f0;
}
.session-item { position: relative; padding: 12px 0; padding-left: 20px; }
.session-item::before {
  content: ''; position: absolute; left: -20px; top: 18px;
  width: 10px; height: 10px; background: #fff;
  border: 2px solid #0B5DEA; border-radius: 50%;
}
.session-item .session-time { font-size: 12px; color: #999; margin-bottom: 6px; }
.session-item .session-content {
  background: #fafafa; border-radius: 6px; padding: 10px 14px;
  display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
}
.session-item .session-field { display: flex; align-items: center; gap: 6px; font-size: 13px; }
.session-item .session-field .label { color: #999; }
.session-item .session-field .value { color: #333; }
.session-tag { display: inline-block; padding: 1px 8px; border-radius: 3px; font-size: 11px; }
.session-tag.good { background: #e6fffb; color: #13c2c2; }
.session-tag.warn { background: #fffbe6; color: #faad14; }
.session-tag.bad { background: #fff1f0; color: #f5222d; }

/* ====== 导出弹窗 ====== */
.export-modal { width: 480px; }
.export-form { display: flex; flex-direction: column; gap: 16px; }
.export-row { display: flex; align-items: center; gap: 10px; }
.export-row label { font-size: 13px; color: #666; min-width: 80px; text-align: right; }
.export-row select, .export-row input {
  flex: 1; height: 32px; border: 1px solid #d9d9d9; border-radius: 4px;
  padding: 0 10px; font-size: 13px; outline: none;
}
.export-row select:focus, .export-row input:focus { border-color: #0B5DEA; }
.export-note {
  background: #f6f8fa; border-radius: 4px; padding: 10px 14px;
  font-size: 12px; color: #999; line-height: 1.6;
}
.export-actions { display: flex; justify-content: flex-end; gap: 8px; padding-top: 8px; }

/* ====== 确认弹窗 ====== */
.confirm-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.45); z-index: 1500; display: none;
  justify-content: center; align-items: center;
}
.confirm-overlay.show { display: flex; }
.confirm-box {
  background: #fff; border-radius: 6px; padding: 24px; width: 380px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.15); animation: modalIn 0.2s ease;
}
.confirm-icon { font-size: 22px; margin-bottom: 12px; }
.confirm-title { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 8px; }
.confirm-desc { font-size: 13px; color: #666; line-height: 1.6; margin-bottom: 20px; }
.confirm-actions { display: flex; justify-content: flex-end; gap: 8px; }
.confirm-btn {
  height: 32px; padding: 0 16px; border-radius: 4px; font-size: 13px;
  cursor: pointer; border: 1px solid #d9d9d9; background: #fff; color: #333;
}
.confirm-btn:hover { border-color: #0B5DEA; color: #0B5DEA; }
.confirm-btn.danger { background: #f5222d; color: #fff; border-color: #f5222d; }
.confirm-btn.danger:hover { background: #ff4d4f; }
.export-btn-confirm { background: #0B5DEA; color: #fff; border-color: #0B5DEA; }
.export-btn-confirm:hover { background: #3a7bef; }



);
  }
  showToast(name + ' 链接已复制');
}

/* ====== Toast ====== */
.toast {
  position: fixed; top: 80px; left: 50%; transform: translateX(-50%) translateY(-10px);
  background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.12); border-radius: 6px;
  padding: 10px 24px; font-size: 13px; z-index: 2000;
  opacity: 0; transition: all 0.3s; pointer-events: none;
  display: flex; align-items: center; gap: 8px;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast .toast-icon { font-size: 16px; }
.toast.success .toast-icon { color: #52c41a; }
.toast.error .toast-icon { color: #f5222d; }
.toast.warn .toast-icon { color: #faad14; }

/* ====== 未命中问题统计页 ====== */
.page-section { display: none; }
.page-section.active { display: block; }

.miss-filter-bar {
  background: #fff; border-radius: 4px; padding: 16px; margin-bottom: 12px;
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
}
.miss-table th .type-badge {
  display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 11px; font-weight: 400;
}
.type-badge.kb { background: #fff7e6; color: #d48806; }
.type-badge.range { background: #f0f5ff; color: #2f54eb; }

/* 增强会话记录表格 */
.session-detail-table { width: 100%; border-collapse: collapse; margin-top: 12px; }
.session-detail-table th {
  background: #fafafa; padding: 8px 12px; font-size: 12px; font-weight: 600;
  color: #666; text-align: left; border-bottom: 1px solid #f0f0f0;
}
.session-detail-table td {
  padding: 10px 12px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0;
}
.session-detail-table tr:hover { background: #f9fbff; }
.session-detail-table .link-btn {
  color: #0B5DEA; cursor: pointer; font-size: 12px;
}
.session-detail-table .link-btn:hover { text-decoration: underline; }


/* ====== 会话记录页 ====== */
.session-log-table { width: 100%; border-collapse: collapse; }
.session-log-table th {
  background: #fafafa; padding: 10px 12px; font-size: 13px; font-weight: 600;
  color: #333; text-align: left; border-bottom: 1px solid #f0f0f0; white-space: nowrap;
}
.session-log-table td {
  padding: 12px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0;
}
.session-log-table tr:hover { background: #f9fbff; }

/* 会话详情弹窗 */
.session-detail-modal { width: 680px; height: 560px; }
.session-chat-wrap {
  flex: 1; overflow-y: auto; padding: 16px 20px;
  display: flex; flex-direction: column; gap: 12px;
  background: #f9f9f9; border-radius: 6px; margin-top: 12px;
}
.session-chat-msg { display: flex; gap: 8px; align-items: flex-end; max-width: 85%; }
.session-chat-msg.user { flex-direction: row-reverse; align-self: flex-end; }
.session-chat-msg.ai { align-self: flex-start; }
.session-chat-avatar {
  width: 28px; height: 28px; border-radius: 6px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; color: #fff;
}
.session-chat-avatar.ai { background: #2f54eb; }
.session-chat-avatar.user { background: #c9a96e; }
.session-chat-bubble {
  padding: 8px 12px; border-radius: 8px; font-size: 13px; line-height: 1.5;
}
.session-chat-bubble.ai { background: #fff; color: #333; border: 1px solid #f0f0f0; }
.session-chat-bubble.user { background: #0B5DEA; color: #fff; }
.session-chat-time {
  font-size: 11px; color: #999; text-align: center; padding: 4px 0;
}
.session-meta-row {
  display: flex; gap: 24px; padding: 12px 0; border-bottom: 1px solid #f0f0f0;
  font-size: 13px;
}
.session-meta-row .label { color: #999; }
.session-meta-row .value { color: #333; font-weight: 500; }


/* ====== 二维码管理页 ====== */
.qrcode-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px; padding: 16px;
}
.qrcode-card {
  background: #fff; border: 1px solid #f0f0f0; border-radius: 8px;
  padding: 20px; text-align: center; transition: all 0.15s; cursor: pointer;
}
.qrcode-card:hover { border-color: #0B5DEA; box-shadow: 0 2px 12px rgba(11,93,234,0.08); }
.qrcode-img {
  width: 140px; height: 140px; margin: 0 auto 12px;
  background: #f5f5f5; border: 1px solid #e8e8e8; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
}
.qrcode-img .qr-pattern {
  width: 100px; height: 100px;
  background: repeating-conic-gradient(#333 0% 25%, #fff 0% 50%) 0 0 / 10px 10px;
  border-radius: 4px; position: relative;
}
.qrcode-img .qr-center {
  position: absolute; width: 30px; height: 30px; background: #fff;
  border-radius: 4px; display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 600; color: #333; border: 1px solid #e8e8e8;
}
.qrcode-customer-name {
  font-size: 15px; font-weight: 600; color: #333; margin-bottom: 4px;
}
.qrcode-hint {
  font-size: 12px; color: #999; margin-bottom: 12px;
}
.qrcode-actions {
  display: flex; gap: 8px; justify-content: center;
}
.qrcode-btn {
  height: 30px; padding: 0 12px; border: 1px solid #d9d9d9; border-radius: 4px;
  background: #fff; font-size: 12px; color: #666; cursor: pointer;
  display: flex; align-items: center; gap: 4px; transition: all 0.15s;
}
.qrcode-btn:hover { color: #0B5DEA; border-color: #0B5DEA; }
.qrcode-btn.primary { background: #0B5DEA; color: #fff; border-color: #0B5DEA; }
.qrcode-btn.primary:hover { background: #3a7bef; }
.qrcode-btn svg { width: 12px; height: 12px; }

/* 二维码预览弹窗 */
.qrcode-preview-modal { width: 400px; }
.qrcode-preview-wrap {
  text-align: center; padding: 20px 0;
}
.qrcode-preview-img {
  width: 200px; height: 200px; margin: 0 auto 16px;
  background: #f5f5f5; border: 1px solid #e8e8e8; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.qrcode-preview-name { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 4px; }
.qrcode-preview-hint { font-size: 13px; color: #999; margin-bottom: 16px; }
.qrcode-preview-link {
  background: #f6f8fa; border-radius: 4px; padding: 10px 14px;
  font-size: 12px; color: #666; word-break: break-all; text-align: left;
  display: flex; align-items: center; justify-content: space-between;
}
.qrcode-preview-link .copy-link-btn {
  color: #0B5DEA; cursor: pointer; font-size: 12px; white-space: nowrap; margin-left: 12px;
}



/* ====== 场馆管理页 ====== */
.qr-thumb {
  width:36px; height:36px; border:1px solid #e8e8e8; border-radius:4px;
  background:#f5f5f5; display:inline-flex; align-items:center; justify-content:center;
  position:relative; overflow:hidden; cursor:pointer;
}
.qr-thumb .qr-pattern {
  width:24px; height:24px;
  background: repeating-conic-gradient(#333 0% 25%, #fff 0% 50%) 0 0 / 4px 4px;
  border-radius:2px;
}
.qr-thumb .qr-center {
  position:absolute; width:10px; height:10px; background:#fff;
  border-radius:1px; display:flex; align-items:center; justify-content:center;
  font-size:5px; border:1px solid #e8e8e8;
}

/* 场馆详情弹窗 */
.venue-detail-modal { width: 700px; max-height: 70vh; }
.venue-detail-section { padding: 20px 24px; }
.venue-qr-section {
  display: flex; align-items: flex-start; gap: 24px;
  padding: 16px 0;
}
.venue-qr-img {
  width: 160px; height: 160px; background: #f5f5f5; border: 1px solid #e8e8e8;
  border-radius: 8px; display: flex; align-items: center; justify-content: center;
  position: relative; flex-shrink: 0;
}
.venue-qr-info { flex: 1; }
.venue-qr-info .info-item { margin-bottom: 12px; }

/* 场馆表单 */
.venue-form { display: flex; flex-direction: column; gap: 16px; }
.venue-form .form-row { display: flex; align-items: center; gap: 8px; }
.venue-form .form-label { font-size: 13px; color: #666; min-width: 80px; text-align: right; }
.venue-form .form-control {
  flex: 1; height: 32px; border: 1px solid #d9d9d9; border-radius: 4px;
  padding: 0 10px; font-size: 13px; outline: none;
}
.venue-form .form-control:focus { border-color: #0B5DEA; }
.venue-form textarea.form-control { height: 60px; padding: 8px 10px; resize: vertical; }
.venue-form .form-checkbox {
  display: flex; align-items: center; gap: 6px; font-size: 13px; color: #333;
}

/* 批量二维码表格 */
.batch-qr-table { width: 100%; border-collapse: collapse; }
.batch-qr-table th {
  background: #fafafa; padding: 8px 12px; font-size: 12px; font-weight: 600;
  color: #666; text-align: left; border-bottom: 1px solid #f0f0f0;
}
.batch-qr-table td {
  padding: 10px 12px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0;
}
.batch-qr-table tr:hover { background: #f9fbff; }

/* 删除确认 */
.delete-confirm-box {
  background: #fff; border-radius: 6px; padding: 24px; width: 400px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.15); animation: modalIn 0.2s ease;
}
.delete-confirm-icon { font-size: 22px; margin-bottom: 12px; color: #f5222d; }
.delete-confirm-title { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 8px; }
.delete-confirm-desc { font-size: 13px; color: #666; line-height: 1.6; margin-bottom: 20px; }


/* ====== Toast ====== */
.toast {
  position: fixed; top: 80px; left: 50%; transform: translateX(-50%) translateY(-10px);
  background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.12); border-radius: 6px;
  padding: 10px 24px; font-size: 13px; z-index: 2000;
  opacity: 0; transition: all 0.3s; pointer-events: none;
  display: flex; align-items: center; gap: 8px;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast .toast-icon { font-size: 16px; }
.toast.success .toast-icon { color: #52c41a; }
.toast.error .toast-icon { color: #f5222d; }
.toast.warn .toast-icon { color: #faad14; }

/* ====== 未命中问题统计页 ====== */
.page-section { display: none; }
.page-section.active { display: block; }

.miss-filter-bar {
  background: #fff; border-radius: 4px; padding: 16px; margin-bottom: 12px;
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
}
.miss-table th .type-badge {
  display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 11px; font-weight: 400;
}
.type-badge.kb { background: #fff7e6; color: #d48806; }
.type-badge.range { background: #f0f5ff; color: #2f54eb; }

/* 增强会话记录表格 */
.session-detail-table { width: 100%; border-collapse: collapse; margin-top: 12px; }
.session-detail-table th {
  background: #fafafa; padding: 8px 12px; font-size: 12px; font-weight: 600;
  color: #666; text-align: left; border-bottom: 1px solid #f0f0f0;
}
.session-detail-table td {
  padding: 10px 12px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0;
}
.session-detail-table tr:hover { background: #f9fbff; }
.session-detail-table .link-btn {
  color: #0B5DEA; cursor: pointer; font-size: 12px;
}
.session-detail-table .link-btn:hover { text-decoration: underline; }

/* ====== 会话记录页 ====== */
.session-log-table { width: 100%; border-collapse: collapse; }
.session-log-table th {
  background: #fafafa; padding: 10px 12px; font-size: 13px; font-weight: 600;
  color: #333; text-align: left; border-bottom: 1px solid #f0f0f0; white-space: nowrap;
}
.session-log-table td {
  padding: 12px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0;
}
.session-log-table tr:hover { background: #f9fbff; }

/* 会话详情弹窗 */
.session-detail-modal { width: 680px; height: 560px; }
.session-chat-wrap {
  flex: 1; overflow-y: auto; padding: 16px 20px;
  display: flex; flex-direction: column; gap: 12px;
  background: #f9f9f9; border-radius: 6px; margin-top: 12px;
}
.session-chat-msg { display: flex; gap: 8px; align-items: flex-end; max-width: 85%; }
.session-chat-msg.user { flex-direction: row-reverse; align-self: flex-end; }
.session-chat-msg.ai { align-self: flex-start; }
.session-chat-avatar {
  width: 28px; height: 28px; border-radius: 6px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; color: #fff;
}
.session-chat-avatar.ai { background: #2f54eb; }
.session-chat-avatar.user { background: #c9a96e; }
.session-chat-bubble {
  padding: 8px 12px; border-radius: 8px; font-size: 13px; line-height: 1.5;
}
.session-chat-bubble.ai { background: #fff; color: #333; border: 1px solid #f0f0f0; }
.session-chat-bubble.user { background: #0B5DEA; color: #fff; }
.session-chat-time {
  font-size: 11px; color: #999; text-align: center; padding: 4px 0;
}
.session-meta-row {
  display: flex; gap: 24px; padding: 12px 0; border-bottom: 1px solid #f0f0f0;
  font-size: 13px;
}
.session-meta-row .label { color: #999; }
.session-meta-row .value { color: #333; font-weight: 500; }

/* ====== 知识库管理弹窗 ====== */
.faq-form { display: flex; flex-direction: column; gap: 16px; }
.faq-form .form-row { display: flex; align-items: flex-start; gap: 8px; }
.faq-form .form-label { font-size: 13px; color: #666; min-width: 90px; text-align: right; padding-top: 6px; }
.faq-form .form-control { flex: 1; height: 32px; border: 1px solid #d9d9d9; border-radius: 4px; padding: 0 10px; font-size: 13px; outline: none; }
.faq-form .form-control:focus { border-color: #0B5DEA; }
.faq-form textarea.form-control { height: 80px; padding: 8px 10px; resize: vertical; }
.faq-form .form-hint { font-size: 11px; color: #999; margin-top: 4px; }
.faq-form .required { color: #f5222d; }
.kb-tag { display: inline-block; padding: 1px 8px; background: #f0f5ff; border: 1px solid #d6e4ff; border-radius: 3px; font-size: 12px; color: #0B5DEA; margin-right: 4px; }
.link-btn { color: #0B5DEA; cursor: pointer; font-size: 12px; }
.link-btn:hover { text-decoration: underline; }

/* Tooltip icon */
.tooltip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999;
  font-size: 11px;
  cursor: help;
  position: relative;
  vertical-align: middle;
  margin-left: 2px;
  font-weight: 600;
  flex-shrink: 0;
}

/* 场馆管理Tab样式 */
.venue-tab { padding: 10px 20px; font-size: 14px; color: #666; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; }
.venue-tab:hover { color: #1890ff; }
.venue-tab.active { color: #1890ff; border-bottom-color: #1890ff; font-weight: 500; }

</style>
</head>
<body>

<div class="layout">
  <!-- ====== 左侧导航 ====== -->
  <div class="sidebar">
    <div class="sidebar-logo"><span>智融平台</span></div>
    
    <div class="sidebar-menu">
      <div class="menu-item"><span class="menu-icon">🏠</span>首页</div>
      <div class="menu-group-title"><span class="menu-icon">🏭</span>生产管理<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <div class="menu-group-title"><span class="menu-icon">⭐</span>智能排播<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <div class="menu-group-title"><span class="menu-icon">📋</span>排播计划v2<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <div class="menu-group-title"><span class="menu-icon">👕</span>主题管理<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <!-- 客户管理V2 子菜单已隐藏 -->
      <div class="menu-group-title"><span class="menu-icon">📺</span>设备管理<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <div class="menu-group-title"><span class="menu-icon">📦</span>仓库设备管理<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <div class="menu-group-title"><span class="menu-icon">📜</span>播放列表<span class="menu-arrow">▾</span></div>
      <div class="sub-menu"></div>
      <!-- 智能导游（放在下方） -->
      <div class="menu-group-title expanded" onclick="toggleMenu(this)">
        <span class="menu-icon">🏛️</span>智能导游<span class="menu-arrow">▾</span>
      </div>
      <div class="sub-menu open">
        <div class="menu-item active" onclick="switchPage('用户管理', this)" id="menuUserMgmt">用户管理</div>
        <div class="menu-item" onclick="switchPage('场馆管理', this)" id="menuVenueMgmt">场馆管理</div>
        <div class="menu-item" onclick="switchPage('知识库管理', this)" id="menuKbMgmt">知识库管理</div>
        <div class="menu-item" onclick="switchPage('会话记录', this)" id="menuSessionLogs">会话记录</div>
        <div class="menu-item" onclick="switchPage('未命中问题统计', this)" id="menuMissStats">未命中问题统计</div>
      </div>
    </div>
  </div>

  <!-- ====== 右侧主区域 ====== -->
  <div class="main-area">
    <div class="top-nav">
      <div class="breadcrumb">
        <a href="#">首页</a><span class="sep">/</span>
        <span style="color:#0B5DEA;">智能导游</span><span class="sep">/</span>
        <span class="current">用户管理</span>
      </div>
      <div class="top-nav-right">
        <span class="nav-greeting">您好，张三</span>
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22 4 12 13 2 4"/></svg>
          <span class="nav-badge">0</span>
        </div>
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          <span class="nav-badge">16</span>
        </div>
        <div class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          <span class="nav-badge">48</span>
        </div>
        <div class="nav-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
      </div>
    </div>

    <div class="content-area">
      <!-- build.py 注入页面 -->
    </div><!-- /content-area -->
  </div><!-- /main-area -->
</div><!-- /layout -->

<!-- ====== 用户详情弹窗（固定620px高） ====== -->
<div class="modal-overlay" id="userDetailModal">
  <div class="modal user-detail-modal">
    <div class="modal-header">
      <h3 id="detailTitle">用户详情</h3>
      <button class="modal-close" onclick="closeUserDetail()">✕</button>
    </div>
    <div class="detail-tabs" id="detailTabs">
      <div class="detail-tab active" onclick="switchTab(0, this)">基本信息</div>
      <div class="detail-tab" onclick="switchTab(1, this)">访问记录</div>
      <div class="detail-tab" onclick="switchTab(2, this)">会话记录</div>
    </div>
    <div class="detail-content active" id="tab0"><div class="info-grid" id="userInfoGrid"></div></div>
    <div class="detail-content" id="tab1"><div class="venue-list" id="venueList"></div></div>
    <div class="detail-content" id="tab2"><div class="session-timeline" id="sessionTimeline"></div></div>
  </div>
</div>

<!-- ====== 导出弹窗 ====== -->
<div class="modal-overlay" id="exportModal">
  <div class="modal export-modal">
    <div class="modal-header">
      <h3>导出用户数据</h3>
      <button class="modal-close" onclick="closeExportModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="export-form">
        <div class="export-row">
          <label>最近访问客户：</label>
          <select id="exportCustomer">
            <option value="">全部客户</option>
            <option>XX博物馆</option>
            <option>科技馆</option>
            <option>自然博物馆</option>
          </select>
        </div>
        <div class="export-row">
          <label>账号状态：</label>
          <select id="exportStatus">
            <option value="">全部</option>
            <option>正常</option>
            <option>已禁用</option>
          </select>
        </div>
        <div class="export-row">
          <label>注册时间：</label>
          <input type="date" id="exportStart" value="2026-01-01">
          <span style="color:#999;">至</span>
          <input type="date" id="exportEnd" value="2026-07-08">
        </div>
        <div class="export-note">
          <b>导出说明：</b><br>
          • 选择「相关客户」后，仅导出该客户下的用户数据<br>
          • 不选择客户则导出全部数据<br>
          • 导出字段：手机号、昵称、相关客户、总会话数、累计兜底次数、最近访问时间、注册时间、状态
        </div>
        <div class="export-actions">
          <button class="confirm-btn" onclick="closeExportModal()">取消</button>
          <button class="confirm-btn export-btn-confirm" onclick="doExport()">确认导出</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ====== 未命中问题弹窗（已迁移为独立页面） ====== -->
<div class="modal-overlay" id="missModal">
  <div class="modal" style="width:720px;">
    <div class="modal-header">
      <h3>未命中问题统计</h3>
      <button class="modal-close" onclick="closeMissModal()">✕</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div style="font-size:13px;color:#999;">统计周期：近30天 ｜ 客户：<b style="color:#333;">全部</b></div>
        <button class="toolbar-btn" onclick="showToast('导出Excel...', 'success')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          导出Excel
        </button>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <div style="border:1px solid #f0f0f0;border-radius:6px;padding:12px 14px;display:flex;align-items:center;gap:12px;">
          <div style="width:24px;height:24px;background:#fff1f0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#f5222d;flex-shrink:0;">1</div>
          <div style="flex:1;"><div style="font-size:14px;color:#333;margin-bottom:4px;">附近有什么好吃的推荐</div><div style="font-size:12px;color:#999;">客户：XX博物馆 ｜ 最近：2026-07-07</div></div>
          <div style="font-size:13px;font-weight:600;color:#f5222d;">18次</div>
        </div>
        <div style="border:1px solid #f0f0f0;border-radius:6px;padding:12px 14px;display:flex;align-items:center;gap:12px;">
          <div style="width:24px;height:24px;background:#fff1f0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#f5222d;flex-shrink:0;">2</div>
          <div style="flex:1;"><div style="font-size:14px;color:#333;margin-bottom:4px;">有没有停车场，怎么收费</div><div style="font-size:12px;color:#999;">客户：XX博物馆 ｜ 最近：2026-07-06</div></div>
          <div style="font-size:13px;font-weight:600;color:#f5222d;">12次</div>
        </div>
        <div style="border:1px solid #f0f0f0;border-radius:6px;padding:12px 14px;display:flex;align-items:center;gap:12px;">
          <div style="width:24px;height:24px;background:#fff1f0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#f5222d;flex-shrink:0;">3</div>
          <div style="flex:1;"><div style="font-size:14px;color:#333;margin-bottom:4px;">可以带宠物进来吗</div><div style="font-size:12px;color:#999;">客户：科技馆 ｜ 最近：2026-07-05</div></div>
          <div style="font-size:13px;font-weight:600;color:#f5222d;">9次</div>
        </div>
        <div style="border:1px solid #f0f0f0;border-radius:6px;padding:12px 14px;display:flex;align-items:center;gap:12px;">
          <div style="width:24px;height:24px;background:#f0f0f0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#666;flex-shrink:0;">4</div>
          <div style="flex:1;"><div style="font-size:14px;color:#333;margin-bottom:4px;">有没有讲解员服务</div><div style="font-size:12px;color:#999;">客户：XX博物馆 ｜ 最近：2026-07-04</div></div>
          <div style="font-size:13px;font-weight:600;color:#f5222d;">7次</div>
        </div>
        <div style="border:1px solid #f0f0f0;border-radius:6px;padding:12px 14px;display:flex;align-items:center;gap:12px;">
          <div style="width:24px;height:24px;background:#f0f0f0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#666;flex-shrink:0;">5</div>
          <div style="flex:1;"><div style="font-size:14px;color:#333;margin-bottom:4px;">文创商店在哪里</div><div style="font-size:12px;color:#999;">客户：自然博物馆 ｜ 最近：2026-07-03</div></div>
          <div style="font-size:13px;font-weight:600;color:#f5222d;">5次</div>
        </div>
      </div>
      <div style="text-align:center;padding:16px 0;font-size:13px;color:#999;">以上问题建议补充到对应客户的 Dify 知识库中</div>
    </div>
  </div>
</div>

<!-- ====== 二维码预览弹窗 ====== -->
<div class="modal-overlay" id="qrcodePreviewModal">
  <div class="modal qrcode-preview-modal">
    <div class="modal-header">
      <h3 id="qrcodePreviewTitle">二维码预览</h3>
      <button class="modal-close" onclick="closeQrcodePreview()">✕</button>
    </div>
    <div class="modal-body">
      <div class="qrcode-preview-wrap">
        <div class="qrcode-preview-img">
          <div class="qr-pattern" style="width:140px;height:140px;"></div>
          <div class="qr-center" id="qrcodePreviewIcon" style="width:40px;height:40px;font-size:18px;">🏛️</div>
        </div>
        <div class="qrcode-preview-name" id="qrcodePreviewName">XX博物馆</div>
        <div class="qrcode-preview-hint">扫码开启AI智能导游</div>
      </div>
    </div>
    <div style="display:flex;border-top:1px solid #f0f0f0;">
      <button style="flex:1;height:46px;border:none;background:#fff;font-size:14px;color:#666;cursor:pointer;" onclick="closeQrcodePreview()">关闭</button>
      <button style="flex:1;height:46px;border:none;background:#fff;font-size:14px;color:#0B5DEA;font-weight:600;cursor:pointer;border-left:1px solid #f0f0f0;" onclick="doDownloadQrcode()">下载PNG</button>
    </div>
  </div>
</div>

<!-- ====== 会话详情弹窗 ====== -->
<div class="modal-overlay" id="sessionDetailModal">
  <div class="modal session-detail-modal">
    <div class="modal-header">
      <h3 id="sessionDetailTitle">会话详情</h3>
      <button class="modal-close" onclick="closeSessionDetail()">✕</button>
    </div>
    <div class="modal-body" style="padding:16px 24px;">
      <div class="session-meta-row" id="sessionMetaRow"></div>
      <div style="font-size:13px;font-weight:600;color:#333;margin:12px 0 8px;">对话记录</div>
      <div class="session-chat-wrap" id="sessionChatWrap"></div>
    </div>
  </div>
</div>

<!-- 确认弹窗 -->
<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <div class="confirm-icon">⚠️</div>
    <div class="confirm-title" id="confirmTitle">确认禁用用户？</div>
    <div class="confirm-desc" id="confirmDesc">禁用后该用户将无法使用智能导游服务，扫码进入时会提示"账号已被禁用"。</div>
    <div class="confirm-actions">
      <button class="confirm-btn" onclick="closeConfirm()">取消</button>
      <button class="confirm-btn danger" onclick="doDisable()">确认禁用</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- ====== 会话记录导出弹窗 ====== -->
<div class="modal-overlay" id="sessionExportModal" data-anno="log-export">
  <div class="modal export-modal">
    <div class="modal-header">
      <h3>导出会话记录</h3>
      <button class="modal-close" onclick="closeSessionExportModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="export-form">
        <div class="export-row">
          <label>来源客户：</label>
          <select id="sessionExportCustomer">
            <option value="">全部客户</option>
            <option>XX博物馆</option>
            <option>科技馆</option>
            <option>自然博物馆</option>
          </select>
        </div>
        <div class="export-row">
          <label>会话质量：</label>
          <select id="sessionExportQuality">
            <option value="">全部</option>
            <option value="good">顺利</option>
            <option value="warn">有兜底</option>
            <option value="bad">较多兜底</option>
          </select>
        </div>
        <div class="export-row">
          <label>时间范围：</label>
          <input type="date" id="sessionExportStart" value="2026-01-01">
          <span style="color:#999;">至</span>
          <input type="date" id="sessionExportEnd" value="2026-07-09">
        </div>
        <div class="export-note">
          <b>导出说明：</b><br>
          • 选择「来源客户」后，仅导出该客户下的会话数据<br>
          • 选择「会话质量」后，仅导出对应质量的会话<br>
          • 导出字段：会话ID、用户、来源客户、来源场馆、智能体、开始时间、消息轮次、兜底次数、会话质量
        </div>
        <div class="export-actions">
          <button class="confirm-btn" onclick="closeSessionExportModal()">取消</button>
          <button class="confirm-btn export-btn-confirm" onclick="doSessionExport()">确认导出</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ====== 未命中问题导出弹窗 ====== -->
<div class="modal-overlay" id="missExportModal">
  <div class="modal export-modal">
    <div class="modal-header">
      <h3>导出未命中问题</h3>
      <button class="modal-close" onclick="closeMissExportModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="export-form">
        <div class="export-row">
          <label>来源客户：</label>
          <select id="missExportCustomer">
            <option value="">全部客户</option>
            <option>XX博物馆</option>
            <option>科技馆</option>
            <option>自然博物馆</option>
          </select>
        </div>
        <div class="export-row">
          <label>类型：</label>
          <select id="missExportType">
            <option value="">全部类型</option>
            <option>知识库缺失（可补充）</option>
            <option>超出导游职责（忽略）</option>
            <option>用户表述不清</option>
            <option>其他</option>
          </select>
        </div>
        <div class="export-row">
          <label>处理状态：</label>
          <select id="missExportStatus">
            <option value="">全部</option>
            <option>待处理</option>
            <option>已处理</option>
            <option>已忽略</option>
          </select>
        </div>
        <div class="export-row">
          <label>时间范围：</label>
          <input type="date" id="missExportStart" value="2026-06-09">
          <span style="color:#999;">至</span>
          <input type="date" id="missExportEnd" value="2026-07-09">
        </div>
        <div class="export-note">
          <b>导出说明：</b><br>
          • 支持按客户、类型、处理状态、时间范围筛选<br>
          • 导出字段：问题原文、来源客户、来源场馆、智能体、触发时间、所属用户、类型、处理状态
        </div>
        <div class="export-actions">
          <button class="confirm-btn" onclick="closeMissExportModal()">取消</button>
          <button class="confirm-btn export-btn-confirm" onclick="doMissExport()">确认导出</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ====== 分组详情弹窗 ====== -->
<div class="modal-overlay" id="groupDetailModal">
  <div class="modal" style="width:720px;max-height:80vh;">
    <div class="modal-header">
      <h3 id="groupDetailTitle">分组详情</h3>
      <button class="modal-close" onclick="closeGroupDetail()">✕</button>
    </div>
    <div class="modal-body" style="padding:16px 24px;">
      <div style="display:flex;gap:20px;margin-bottom:16px;font-size:13px;">
        <span id="groupDetailCategory"></span>
        <span id="groupDetailCustomer"></span>
        <span id="groupDetailVenue"></span>
        <span id="groupDetailAIType"></span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <span style="font-size:13px;color:#666;" id="groupDetailCount"></span>
        <div style="display:flex;gap:8px;">
          <button class="filter-btn primary" onclick="markAllGroupHandled('已处理')">全部加入知识库</button>
          <button class="filter-btn" onclick="markAllGroupHandled('已忽略')">全部忽略</button>
        </div>
      </div>
      <div class="table-card">
        <table>
          <thead>
            <tr>
              <th style="width:220px;">问题原文</th>
              <th style="width:130px;">所属用户</th>
              <th style="width:130px;">触发时间</th>
              <th style="width:90px;">状态</th>
              <th style="width:100px;">操作</th>
            </tr>
          </thead>
          <tbody id="groupDetailBody">
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ====== 新增场馆弹窗 ====== -->
<div class="modal-overlay" id="addVenueModal">
  <div class="modal" style="width:520px;">
    <div class="modal-header">
      <h3>新增场馆</h3>
      <button class="modal-close" onclick="closeAddVenueModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="venue-form">
        <div class="form-row">
          <span class="form-label">所属客户：<span style="color:#f5222d;">*</span></span>
          <select class="form-control" id="addVenueCustomer">
            <option value="">请选择客户</option>
            <option>XX博物馆</option>
            <option>科技馆</option>
            <option>自然博物馆</option>
          </select>
        </div>
        <div class="form-row">
          <span class="form-label">场馆名称：<span style="color:#f5222d;">*</span></span>
          <input type="text" class="form-control" id="addVenueName" placeholder="请输入场馆名称">
        </div>
        <div class="form-row">
          <span class="form-label">场馆Logo：</span>
          <div style="display:flex;align-items:center;gap:12px;">
            <div id="addVenueLogoPreview" style="width:60px;height:60px;border:1px dashed #d9d9d9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;">Logo</div>
            <button class="filter-btn" onclick="showToast('Logo上传功能（演示）')">上传</button>
          </div>
          <div style="font-size:12px;color:#999;margin-left:80px;">logo图片格式限制为：PNG、JPG</div>
        </div>
        <div class="form-row">
          <span class="form-label">状态：<span style="color:#f5222d;">*</span></span>
          <select class="form-control" id="addVenueStatus">
            <option value="active">启用</option>
            <option value="disabled">停用</option>
          </select>
        </div>
        <div class="form-row">
          <span class="form-label">智能体：</span>
          <div style="flex:1;position:relative;">
            <input type="text" class="form-control" id="addVenueAgent" placeholder="搜索智能体..." style="width:100%;" onfocus="this.nextElementSibling.style.display='block'" onblur="setTimeout(()=>this.nextElementSibling.style.display='none',200)">
            <div style="display:none;position:absolute;top:32px;left:0;right:0;background:#fff;border:1px solid #d9d9d9;border-radius:4px;z-index:10;max-height:150px;overflow-y:auto;">
              <div style="padding:8px 10px;cursor:pointer;font-size:13px;" onmousedown="document.getElementById('addVenueAgent').value='博物馆导览助手'">博物馆导览助手</div>
              <div style="padding:8px 10px;cursor:pointer;font-size:13px;" onmousedown="document.getElementById('addVenueAgent').value='科技馆讲解员'">科技馆讲解员</div>
              <div style="padding:8px 10px;cursor:pointer;font-size:13px;" onmousedown="document.getElementById('addVenueAgent').value='自然百科向导'">自然百科向导</div>
            </div>
          </div>
        </div>
        <div class="form-row">
          <span class="form-label">备注：</span>
          <textarea class="form-control" id="addVenueRemark" placeholder="请输入备注信息（选填）"></textarea>
        </div>

      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid #f0f0f0;">
        <button class="confirm-btn" onclick="closeAddVenueModal()">取消</button>
        <button class="confirm-btn export-btn-confirm" onclick="saveVenue()">确认创建</button>
      </div>
    </div>
  </div>
</div>

