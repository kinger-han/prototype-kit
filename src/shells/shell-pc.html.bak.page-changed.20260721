<!-- ====== 知识库删除确认弹窗 ====== -->
<div class="confirm-overlay" id="deleteKbConfirm">
  <div class="delete-confirm-box">
    <div class="delete-confirm-icon">&#9888;&#65039;</div>
    <div class="delete-confirm-title">确认删除？</div>
    <div class="delete-confirm-desc">删除后将同步删除 Dify 知识库中的对应数据，此操作不可恢复。</div>
    <div class="confirm-actions">
      <button class="confirm-btn" onclick="closeDeleteKbConfirm()">取消</button>
      <button class="confirm-btn danger" onclick="doDeleteKb()">确认删除</button>
    </div>
  </div>
</div>

<!-- ====== 知识库导出弹窗 ====== -->
<div class="modal-overlay" id="kbExportModal">
  <div class="modal export-modal">
    <div class="modal-header">
      <h3>导出知识库数据</h3>
      <button class="modal-close" onclick="closeKbExportModal()">&#10005;</button>
    </div>
    <div class="modal-body">
      <div class="export-form">
        <div class="export-row"><label>所属客户：</label><select><option value="">全部客户</option><option>XX博物馆</option><option>科技馆</option><option>自然博物馆</option></select></div>
        <div class="export-row"><label>内容类型：</label><select><option value="">全部</option><option>问答（FAQ）</option><option>文档</option></select></div>
        <div class="export-row"><label>状态：</label><select><option value="">全部</option><option>解析中</option><option>已生效</option><option>解析失败</option></select></div>
        <div class="export-note"><b>导出说明：</b><br>支持按客户、类型、状态筛选<br>导出字段：内容类型、标题/问题、答案/摘要、相似问法、所属客户、所属场馆、分类标签、来源、状态、命中次数</div>
        <div class="export-actions">
          <button class="confirm-btn" onclick="closeKbExportModal()">取消</button>
          <button class="confirm-btn export-btn-confirm" onclick="doKbExport()">确认导出</button>
        </div>
      </div>
    </div>
  </div>
</div>

