          <span class="form-label">场馆名称：<span style="color:#f5222d;">*</span></span>
          <input type="text" class="form-control" id="editVenueName" placeholder="请输入场馆名称">
        </div>
        <div class="form-row">
          <span class="form-label">场馆Logo：</span>
          <div style="display:flex;align-items:center;gap:12px;">
            <div id="editVenueLogoPreview" style="width:60px;height:60px;border:1px dashed #d9d9d9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;">Logo</div>
            <button class="filter-btn" onclick="showToast('Logo上传功能（演示）')">上传</button>
          </div>
          <div style="font-size:12px;color:#999;margin-left:80px;">logo图片格式限制为：PNG、JPG</div>
        </div>
        <div class="form-row">
          <span class="form-label">状态：</span>
          <select class="form-control" id="editVenueStatus">
            <option value="active">启用</option>
            <option value="disabled">停用</option>
          </select>
        </div>
        <div class="form-row">
          <span class="form-label">备注：</span>
          <textarea class="form-control" id="editVenueRemark" placeholder="请输入备注信息（选填）"></textarea>
        </div>
        <div class="form-row">
          <span class="form-label">智能体：</span>
          <div style="flex:1;position:relative;">
            <input type="text" class="form-control" id="editVenueAgent" placeholder="搜索智能体..." style="width:100%;" onfocus="this.nextElementSibling.style.display='block'" onblur="setTimeout(()=>this.nextElementSibling.style.display='none',200)">
            <div style="display:none;position:absolute;top:32px;left:0;right:0;background:#fff;border:1px solid #d9d9d9;border-radius:4px;z-index:10;max-height:150px;overflow-y:auto;">
              <div style="padding:8px 10px;cursor:pointer;font-size:13px;" onmousedown="document.getElementById('editVenueAgent').value='博物馆导览助手'">博物馆导览助手</div>
              <div style="padding:8px 10px;cursor:pointer;font-size:13px;" onmousedown="document.getElementById('editVenueAgent').value='科技馆讲解员'">科技馆讲解员</div>
              <div style="padding:8px 10px;cursor:pointer;font-size:13px;" onmousedown="document.getElementById('editVenueAgent').value='自然百科向导'">自然百科向导</div>
            </div>
          </div>
        </div>
        <!-- QR section (read-only) -->
        <div style="margin-top:8px;padding-top:12px;border-top:1px solid #f0f0f0;">
          <div style="font-size:13px;font-weight:600;color:#333;margin-bottom:12px;">二维码信息</div>
          <div class="form-row">
            <span class="form-label">二维码：</span>
            <div id="editVenueQrThumb" style="width:60px;height:60px;border:1px solid #e8e8e8;border-radius:4px;background:#f5f5f5;display:inline-flex;align-items:center;justify-content:center;position:relative;overflow:hidden;"></div>
          </div>
          <div class="form-row" style="margin-top:8px;">
            <span class="form-label">扫码次数：</span>
            <span class="info-value" id="editVenueScanCount">0</span>
          </div>
          <div class="form-row" style="margin-top:8px;">
            <span class="form-label">最近扫码时间：</span>
            <span class="info-value" id="editVenueLastScan">—</span>
          </div>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid #f0f0f0;">
        <button class="confirm-btn" onclick="closeEditVenueModal()">取消</button>
        <button class="confirm-btn export-btn-confirm" onclick="saveEditVenue()">保存</button>
      </div>
    </div>
  </div>
</div>

